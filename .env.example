OPENAI_API_KEY=your_openai_api_key
PORT=5000
# Optional: set a model ID. Defaults to gpt-4o-mini for OpenAI and
# openai/gpt-oss-120b for a Groq key (gsk_...)
OPENAI_MODEL=
# Optional: Groq is detected from a gsk_ key automatically; otherwise set this:
OPENAI_BASE_URL=
# Optional comma-separated list of additional trusted browser origins
ALLOWED_ORIGINS=

